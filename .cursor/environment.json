{
  "name": "WhatsApp Gateway Hub",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": "./.cursor/install.sh",
  "start": "sudo service redis-server start || redis-server --daemonize yes",
  "terminals": [
    {
      "name": "server",
      "command": "php artisan octane:start --server=frankenphp --host=0.0.0.0 --port=8000"
    },
    {
      "name": "reverb",
      "command": "php artisan reverb:start --host=0.0.0.0 --port=8080"
    },
    {
      "name": "horizon",
      "command": "php artisan horizon"
    },
    {
      "name": "scheduler",
      "command": "php artisan schedule:work"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 8000
    },
    {
      "name": "reverb",
      "port": 8080
    }
  ]
}
