APP_NAME="WhatsApp Gateway Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime via Laravel Reverb (websockets). Requires `php artisan reverb:start`.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Queue on Redis so Laravel Horizon can supervise workers (run `php artisan horizon`).
QUEUE_CONNECTION=redis
DB_QUEUE_RETRY_AFTER=420

# Laravel Octane application server (high performance). Run `php artisan octane:start`.
OCTANE_SERVER=frankenphp

# Laravel Reverb credentials (generate your own for production).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Attachment uploads are private, limited to 16 MB, and retained for 90 days after use.
GATEWAY_ATTACHMENT_DISK=local
GATEWAY_ATTACHMENT_MAX_BYTES=16777216
GATEWAY_ATTACHMENT_RETENTION_DAYS=90
GATEWAY_ATTACHMENT_ORPHAN_HOURS=24

# Exact provider hostnames. Add real WAHA/GOWA hostnames; plain HTTP must be explicitly listed.
# Self-hosted engine (WAHA/Baileys, see engine/): add its host here too, e.g. GATEWAY_PROVIDER_HTTP_HOSTS=waha.internal
GATEWAY_PROVIDER_HTTPS_HOSTS=api.fonnte.com,graph.facebook.com
GATEWAY_PROVIDER_HTTP_HOSTS=
GATEWAY_PROVIDER_FAILURE_THRESHOLD=3
GATEWAY_PROVIDER_CIRCUIT_SECONDS=300
# sync = no queue worker (web sends after HTTP response). async = requires queue:work
GATEWAY_ALERT_DELIVERY=sync
# Local/dev convenience. Production default (when unset) is async — prefer async + queue:work.
# sync runs DispatchGatewayMessage inline on the HTTP request (admin retry, async intake, recovery).
GATEWAY_DISPATCH=sync

# Optional overrides for the default administrator created by `php artisan db:seed`.
# Defaults: Gateway Administrator / admin@gateway.local / admin12345.
# Leave provider/token values empty to manage them solely from the admin panel.
GATEWAY_SEED_ADMIN_NAME=
GATEWAY_SEED_ADMIN_EMAIL=
GATEWAY_SEED_ADMIN_PASSWORD=
GATEWAY_SEED_WAHA_BASE_URL=
GATEWAY_SEED_WAHA_SESSION=
GATEWAY_SEED_WAHA_API_KEY=
GATEWAY_SEED_FONNTE_ENDPOINT=https://api.fonnte.com/send
GATEWAY_SEED_FONNTE_VALIDATE_ENDPOINT=https://api.fonnte.com/validate
GATEWAY_SEED_FONNTE_TOKEN=
GATEWAY_SEED_FONNTE_ATTACHMENT_MAX_BYTES=4194304
GATEWAY_SEED_GOWA_BASE_URL=
GATEWAY_SEED_GOWA_USERNAME=
GATEWAY_SEED_GOWA_PASSWORD=
GATEWAY_SEED_GOWA_DEVICE_ID=
GATEWAY_SEED_GOWA_VERSION=8.10.0
GATEWAY_SEED_WABA_BASE_URL=https://graph.facebook.com
GATEWAY_SEED_WABA_API_VERSION=v25.0
GATEWAY_SEED_WABA_PHONE_NUMBER_ID=
GATEWAY_SEED_WABA_ACCESS_TOKEN=
GATEWAY_SEED_APPSCRIPT_FT_TOKEN=
GATEWAY_SEED_WEB_CESA_TOKEN=
# Token khusus jalur engine (QR/pairing nomor sendiri). Terpisah dari WAG_TOKEN fallback.
GATEWAY_SEED_WEB_CESA_ENGINE_TOKEN=
# WAHA host untuk sesi engine yang ditautkan user (bukan pool fallback).
GATEWAY_ENGINE_WAHA_SLUG=waha-primary
GATEWAY_SEED_WEB_HELPDESK_TOKEN=
GATEWAY_SEED_WEB_SAM_TOKEN=
GATEWAY_SEED_WEB_SHELF_TOKEN=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
