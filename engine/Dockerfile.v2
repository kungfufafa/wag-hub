FROM php:8.4-apache-bookworm AS runtime-base
RUN apt-get update && apt-get install -y --no-install-recommends \
    git unzip ffmpeg libicu-dev libzip-dev libonig-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j2 pdo_mysql bcmath intl mbstring pcntl zip gd \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
RUN sed -ri 's!/var/www/html!/var/www/html/public!g' /etc/apache2/sites-available/*.conf \
    && sed -ri '/<Directory \/var\/www\//,/<\/Directory>/s/AllowOverride None/AllowOverride All/' /etc/apache2/apache2.conf \
    && printf 'upload_max_filesize=16M\npost_max_size=18M\nmemory_limit=256M\nexpose_php=Off\n' > /usr/local/etc/php/conf.d/wag-engine.ini
WORKDIR /var/www/html

FROM runtime-base AS dependencies
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY . .
RUN mkdir -p storage/app/private storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader \
    && chown -R www-data:www-data storage bootstrap/cache

FROM node:22-bookworm-slim AS assets
WORKDIR /build
COPY --from=dependencies /var/www/html/ ./
RUN npm ci && npm run build

FROM dependencies AS runtime
COPY --from=assets /build/public/build ./public/build
EXPOSE 80
