# Copy to engine/.env.v2; do not commit the filled file.
WAG_PUBLIC_URL=https://wag-hub.example.com
WAG_BIND_ADDRESS=127.0.0.1
WAG_HTTP_PORT=8080
WAG_RELEASE=local
# Generate: php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
WAG_DB_DATABASE=wag_hub
WAG_DB_USERNAME=wag_hub
WAG_DB_PASSWORD=
WAG_DB_ROOT_PASSWORD=
# Generate independently: openssl rand -hex 32
WAG_BAILEYS_TOKEN=
# Generate: openssl rand -base64 32; retain with protected SQL backups.
WAG_BAILEYS_AUTH_KEY=
WAG_DEFAULT_SESSION_LIMIT=5
WAG_DEFAULT_SESSION_CEILING=10
# Explicit comma-separated private callback host exceptions, if required.
WAG_WEBHOOK_PRIVATE_HOSTS=
