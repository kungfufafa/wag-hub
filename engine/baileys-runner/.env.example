WAG_BAILEYS_HOST=127.0.0.1
WAG_BAILEYS_PORT=3318
# Must match WAG_BAILEYS_TOKEN in the Hub .env. Generate with: openssl rand -hex 32
WAG_BAILEYS_TOKEN=

# Production authentication is encrypted SQL. Generate key: openssl rand -base64 32
WAG_BAILEYS_AUTH_MODE=sql
WAG_BAILEYS_AUTH_KEY=
WAG_BAILEYS_DB_HOST=127.0.0.1
WAG_BAILEYS_DB_PORT=3306
WAG_BAILEYS_DB_DATABASE=wag_hub
WAG_BAILEYS_DB_USERNAME=wag_runner
WAG_BAILEYS_DB_PASSWORD=
WAG_BAILEYS_DB_TLS=false
# Hub origin, required in SQL mode. Runner fetches /internal/engine/desired-sessions.
WAG_HUB_CONTROL_URL=http://127.0.0.1:8000
# Keep these on durable private storage; defaults sit alongside sessions/.
# WAG_BAILEYS_SESSION_ROOT=/var/lib/wag-hub/sessions
# WAG_BAILEYS_STATE_ROOT=/var/lib/wag-hub/runner-state
# WAG_BAILEYS_EVENT_ROOT=/var/lib/wag-hub/runner-events
# WAG_BAILEYS_JOURNAL_ROOT=/var/lib/wag-hub/whatsapp-messages
