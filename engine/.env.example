# Copy to engine/.env and fill in. Used by engine/docker-compose.yml.
WAHA_PORT=3000
# API key the Hub sends as X-Api-Key (store the same value in the provider account).
WAHA_API_KEY=change-me-long-random
# WAHA built-in dashboard credentials.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me
